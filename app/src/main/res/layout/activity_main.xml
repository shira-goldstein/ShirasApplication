<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7.10.23!!"
        android:textSize="24sp" />

    <ImageView
        android:id="@+id/ivMemory"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.9"
        android:contentDescription="תמונה של משפחת ביבס"
        android:scaleType="centerCrop"
        android:src="@drawable/bibas_family" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="16dp"
        android:text="לזכר הסיפור של משפחת ביבס היקרה – שירי, ירדן, אריאל וכפיר הקטן, שנחטפו מהבית שלהם בקיבוץ ניר עוז ב־7 באוקטובר. דמותם הפכה לסמל קורע לב של ילדות ותקווה עמוקה בתוך החושך הגדול. לעולם לא נשכח אותם ואת הסיפור שלהם ושל כל שאר המשפחות שנפגעו ב7.10. נמשיך לחבק את המשפחות, ולייחל לימים של שלום ותקווה (מקור התמונה :מאקו)."
        android:textSize="14sp" />

</LinearLayout>